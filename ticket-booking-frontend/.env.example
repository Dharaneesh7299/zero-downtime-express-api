# API Base URL for client-side HTTP requests
# Default: Leave empty ("") to use relative paths (/api) with the Nginx reverse proxy
# For direct browser connection without reverse proxy: http://localhost:4001
# WARNING: Do NOT use internal Docker network names (e.g., http://inventory:4001) because
# browser-side JavaScript runs on the host machine, outside Docker's internal network.
VITE_API_URL=
